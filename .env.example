# Copy this file to .env and fill in your keys. Never commit .env.

# Gemini (Google AI Studio). Free tier. Do NOT enable billing on this project.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DAILY_CALLS=200
GEMINI_PER_MINUTE=8

# Grok (xAI console). Only the promo credits are free. Do NOT add a payment method.
# When the credits run out, the bot notices and lets Gemini take over.
# Set XAI_DAILY_CALLS=0 to turn Grok off entirely.
XAI_API_KEY=
XAI_MODEL=grok-4.3
XAI_DAILY_CALLS=40
XAI_PER_MINUTE=10

# Optional
# TRADER_DB=paper_ledger.db
# CRYPTO_EXCHANGE=kraken

# Email alerts through Resend (optional). The test sender onboarding@resend.dev only
# delivers to the address that owns the Resend account.
RESEND_API_KEY=
EMAIL_TO=
# EMAIL_FROM=Ultron <onboarding@resend.dev>
# Dashboard password. Required when the dashboard is exposed (PORT set, e.g. on Render).
# DASHBOARD_TOKEN=

# Ledger backup, for hosts with a throwaway disk (Render free tier). Optional.
# BACKUP_REPO=you/ultron-state
# BACKUP_GITHUB_TOKEN=

# Cerebras (free tier). Keys start with csk-. Never add a payment method.
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=gpt-oss-120b
# CEREBRAS_DAILY_CALLS=300
# CEREBRAS_PER_MINUTE=20
